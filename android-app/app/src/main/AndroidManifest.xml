<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Downloads land in public Downloads/Revayato via DownloadManager -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:label="روایتو"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true">

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".WatchPartyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme" />

        <!-- Native catalog entry point. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode|smallestScreenSize|density"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Two filters, not one. Android takes the cross-product of every
              <data> element inside a filter, so listing scheme="revayato"
              beside host="revayato.com" only ever matched
              revayato://revayato.com/… — the actual share links,
              revayato://movies/<slug>, matched nothing.

              No autoVerify on the https filter on purpose: verification needs
              /.well-known/assetlinks.json served from revayato.com, and the
              site does not serve one yet. Declaring autoVerify without it makes
              Android 12+ drop the app as a handler entirely, which is strictly
              worse than appearing in the chooser.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="revayato.com" />
                <data android:host="www.revayato.com" />
                <data android:pathPrefix="/movies" />
                <data android:pathPrefix="/series" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/actors" />
                <data android:pathPrefix="/directors" />
                <data android:pathPrefix="/collections" />
                <data android:pathPrefix="/watch-party" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="revayato" />
            </intent-filter>
        </activity>
    </application>
</manifest>
