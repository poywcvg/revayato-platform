<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-only theme matching the site's background #050807. -->
    <!--
      Keep the complete Material theme in a separately named base style. Resource
      variants replace (rather than merge) a style with the same name, so the
      values-v27 AppTheme must inherit this base or MaterialButton crashes at
      startup on API 27+ with "requires your app theme to be Theme.MaterialComponents".
    -->
    <style name="RevayatoBaseTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/site_background</item>
        <item name="android:statusBarColor">@color/site_background</item>
        <item name="android:navigationBarColor">@color/site_background</item>
        <item name="android:windowAnimationStyle">@style/RevayatoWindowAnimation</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:alertDialogTheme">@style/RevayatoDialog</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/brand_lime</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="colorPrimary">@color/brand_lime</item>
        <item name="colorPrimaryVariant">@color/brand_lime</item>
        <item name="colorSecondary">@color/brand_lime</item>
        <item name="colorSurface">@color/site_surface_raised</item>
        <item name="colorOnSurface">@android:color/white</item>
        <item name="colorOnPrimary">@color/site_background</item>
        <item name="shapeAppearanceSmallComponent">@style/RevayatoShapeSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/RevayatoShapeMedium</item>
        <item name="materialAlertDialogTheme">@style/RevayatoMaterialDialog</item>
    </style>

    <style name="AppTheme" parent="RevayatoBaseTheme" />

    <style name="RevayatoShapeSmall" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="RevayatoShapeMedium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="RevayatoMaterialDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/site_surface_raised</item>
        <item name="colorPrimary">@color/brand_lime</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@color/site_muted</item>
        <item name="shapeAppearanceOverlay">@style/RevayatoShapeMedium</item>
    </style>

    <style name="RevayatoDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorAccent">@color/brand_lime</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@color/site_muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:listPreferredItemHeightSmall">52dp</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>

    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/site_background</item>
        <item name="android:navigationBarColor">@color/site_background</item>
    </style>

    <style name="RevayatoWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/page_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/page_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_return_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/page_return_exit</item>
    </style>
</resources>
