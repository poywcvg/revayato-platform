<?xml version="1.0" encoding="utf-8"?>
<!--
  The `session` preferences file holds a JWT access token and a months-long
  refresh token in plain text. android:allowBackup="false" keeps it out of cloud
  backup, but Android 12+ device-to-device transfer is governed separately, so
  exclude it there too: a session should be re-established by signing in on the
  new device, not copied across it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
