{
  email {$ACME_EMAIL}
  admin off
}

{$SITE_DOMAIN} {
  encode zstd gzip

  log {
    output stdout
    format console
  }

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Strict-Transport-Security "max-age={$HSTS_MAX_AGE}"
  }

  handle {
    reverse_proxy frontend:3000
  }
}

{$API_DOMAIN} {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Strict-Transport-Security "max-age={$HSTS_MAX_AGE}"
  }

  handle_path /static/* {
    root * /srv/static
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  @backend path /api/* /admin/* /media/* /ws/*
  handle @backend {
    reverse_proxy backend:8000
  }

  handle {
    reverse_proxy backend:8000
  }
}

# These hosts can point at this Caddy instance or be replaced by an external
# CDN. Object keys are served directly at /<key> when self-hosted.
{$MEDIA_DOMAIN} {
  encode zstd gzip
  root * /srv/media
  header Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
  file_server
}

{$DOWNLOAD_DOMAIN} {
  encode zstd gzip
  root * /srv/downloads
  header Cache-Control "private, max-age=0, no-store"
  file_server
}
