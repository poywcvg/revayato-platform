{
	email {$ACME_EMAIL}
	admin off
}

# Prefer apex: www -> https://{$SITE_DOMAIN}
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Looti (lootti.ir) — independent Docker Compose project in /root/looti.
# Only looti-web joins this edge network; its postgres is internal.
# Apex canonical: www -> apex redirect (same pattern as revayato.com).
www.lootti.ir {
	redir https://lootti.ir{uri} permanent
}

http://lootti.ir, http://www.lootti.ir {
	redir https://lootti.ir{uri} permanent
}

lootti.ir {
	encode zstd gzip
	reverse_proxy looti-web:8000
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# ---- Shared handler set, imported by both the public HTTPS site and the
# ---- native-app direct-origin fallback (plain HTTP on :8080). Keeps the two
# ---- in lockstep so the app gets identical routes on either path.
(site_common) {
	encode zstd gzip

	log {
		output stdout
		format console
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "upgrade-insecure-requests"
	}


	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed gzip zstd
		}
	}

	# Media (posters + progressive video). Range support is required for seek.
	handle_path /media/* {
		root * /srv/media
		header {
			Accept-Ranges bytes
			Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
			# Allow WebGL / canvas textures (MorphSlider) to sample media images.
			Access-Control-Allow-Origin "*"
		}
		@hls path *.m3u8
		header @hls Cache-Control "public, max-age=30, stale-while-revalidate=300"
		@segments path *.ts *.m4s *.mp4 *.webm *.mkv
		header @segments Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		# SoftSub WebVTT must be readable by <track> even when video is cross-origin.
		@vtt path *.vtt *.webvtt
		header @vtt {
			Content-Type "text/vtt; charset=utf-8"
			Access-Control-Allow-Origin "*"
			Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
		}
		file_server
	}

	handle_path /downloads/* {
		root * /srv/downloads
		header Cache-Control "private, max-age=0, no-store"
		# Force a real download instead of letting the browser try to preview the
		# APK inline — in-app browsers (Telegram/Instagram) and some Android
		# browsers otherwise fail silently on the package MIME type.
		header Content-Disposition "attachment"
		header Content-Type "application/octet-stream"
		file_server
	}


	# Playback gateway. Ahead of @backend because /api/stream/* is also /api/*,
	# and these two are nothing alike: a segment request is a long, unbuffered
	# byte stream from a container with its own disk and its own CPU budget,
	# while the API next door must stay snappy. Splitting them here is what
	# keeps one viewer's rewrapped film from occupying a web worker.
	@stream path /api/stream/*
	handle @stream {
		# No Cache-Control of our own: the playlist grows while ffmpeg runs and
		# must never be stored, while a segment may be reused for the minute it
		# survives. Django already says which is which, per response.
		reverse_proxy stream-gateway:8000 {
			flush_interval -1
			transport http {
				# Opening a session waits on ffmpeg producing a real segment, and
				# serving one is a slow read by design; neither may be cut short.
				read_timeout 0
				write_timeout 0
				dial_timeout 5s
			}
		}
	}

	@backend path /api/* /ws/*
	handle @backend {
		# Drop django-cors-headers' "Vary: Origin" so shared caches (Cloudflare)
		# can store public GET responses (catalog/search/home). Cache-Control
		# s-maxage arrives from DRF; a single Vary is all the CDN needs.
		# Private/credentialed responses set Cache-Control: private,no-store
		# from Django and CF never caches them, so no per-origin Vary is lost.
		header -Vary ""
		reverse_proxy backend:8000 {
			# Keep websocket upgrades snappy; flush immediately for realtime.
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
				dial_timeout 5s
			}
		}
	}

	# Hashed Nuxt assets — immutable at the edge even if Nitro misses headers.
	handle /_nuxt/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy frontend:3000
	}

	# Same-origin /media via IPX was drowning the 2-core Nuxt process (CPU resize +
	# public HTTPS fetch loops). Serve the stored file directly; posters/backdrops
	# are already webp. Works for absolute and same-origin relative media URLs.
	@ipx_local_media {
		path_regexp ipx_local ^/_ipx/.+?(/media/.+)$
	}
	handle @ipx_local_media {
		rewrite {re.ipx_local.1}
		root * /srv
		header {
			Accept-Ranges bytes
			Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
		}
		file_server
	}

	handle /_ipx/* {
		header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
		reverse_proxy frontend:3000
	}

	# Versioned/static app shell files: immutable at the edge, never SSR.
	# (robots.txt / sitemap.xml are deliberately excluded — Nitro owns their TTL.)
	@static_assets {
		path /favicon.svg /favicon.ico /favicon.png /favicon-32.png /apple-touch-icon.png /icon-192.png /icon-512.png /site.webmanifest
	}
	handle @static_assets {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy frontend:3000
	}

	# Public HTML: short CDN TTL. Replace any upstream Cache-Control so CF sees one policy.
	@html {
		path /
		path /*
		not path /_nuxt/* /_ipx/* /favicon.ico /favicon.svg /favicon.png /favicon-32.png /apple-touch-icon.png /icon-192.png /icon-512.png /site.webmanifest /robots.txt /sitemap.xml
		not path /dashboard* /profile* /watch-party* /auth* /watchlist /feed
	}

	handle @html {
		# Nitro already emits the SWR policy this route needs
		# ("s-maxage=300, stale-while-revalidate" via routeRules). Do not stack a
		# second Cache-Control here — duplicated headers made cf-cache-status
		# DYNAMIC and pushed every public page back through SSR. Add a browser
		# max-age=0 so clients always revalidate against Edge/SWR instead of
		# pinning stale HTML.
		# NOTE: the set MUST be deferred (post-upstream). A non-deferred set runs
		# before reverse_proxy and the upstream value is appended next to it —
		# seen live as two Cache-Control lines and cf-cache-status DYNAMIC.
		header {
			Cache-Control "public, max-age=0, s-maxage=300, stale-while-revalidate=600"
			Vary "Accept-Encoding"
			defer
		}
		reverse_proxy frontend:3000
	}

	@private_html {
		path /dashboard* /profile* /watch-party* /auth* /watchlist /feed
	}

	handle @private_html {
		header Cache-Control "private, no-store"
		reverse_proxy frontend:3000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

{$SITE_DOMAIN} {
	import site_common

	header Strict-Transport-Security "max-age={$HSTS_MAX_AGE}"
}

# Direct-origin fallback for the native app (Android/TV): plain HTTP on the
# VPS's own public IP, no TLS, no SNI, no CDN. Lets the app reach the API /
# media / downloads even on networks where revayato.com through the Cloudflare
# edge is unreachable (e.g. Iranian ISPs blocking the CF path). The app allows
# cleartext ONLY for this origin, via its network security config.
:8080 {
	import site_common
	header Access-Control-Allow-Origin "*"
}
