# Public origins — changing these values changes generated URLs without a
# database migration. Keep object keys/paths in catalog rows only.
# For best playback speed, point MEDIA_CDN_BASE_URL at a real CDN/R2 edge
# (not the same origin), e.g. https://media.revayato.com
SITE_BASE_URL=https://revayato.com
API_BASE_URL=https://revayato.com
MEDIA_CDN_BASE_URL=https://revayato.com/media
DOWNLOAD_CDN_BASE_URL=https://revayato.com/downloads
WS_BASE_URL=wss://revayato.com
FRONTEND_URL=https://revayato.com

# ASGI workers (uvicorn). Raise carefully against available CPU/RAM.
WEB_CONCURRENCY=2
WEB_LIMIT_CONCURRENCY=80
WEB_KEEPALIVE_SECONDS=15
WEB_MAX_REQUESTS=1500
WEB_MAX_REQUESTS_JITTER=150

# Catalog API Redis cache TTLs (seconds). 0 disables that bucket.
CATALOG_CACHE_LIST_TTL=180
CATALOG_CACHE_DETAIL_TTL=300
CATALOG_CACHE_TRENDING_TTL=120
CATALOG_CACHE_HOME_TTL=300
CATALOG_CACHE_GENRES_TTL=600
CATALOG_CACHE_SEARCH_TTL=30
CATALOG_CACHE_ACTORS_TTL=600

# Reverse-proxy hostnames (used by Caddy TLS).
SITE_DOMAIN=revayato.com
WWW_DOMAIN=www.revayato.com
API_DOMAIN=revayato.com
MEDIA_DOMAIN=revayato.com
DOWNLOAD_DOMAIN=revayato.com
ACME_EMAIL=admin@revayato.com

# Django — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_TOKEN_DAYS=400
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=revayato.com,www.revayato.com
DJANGO_CORS_ALLOWED_ORIGINS=https://revayato.com,https://www.revayato.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://revayato.com,https://www.revayato.com
DJANGO_SECURE_SSL_REDIRECT=False
# Start low for the first deployment; raise to 31536000 after HTTPS is verified.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_LOG_LEVEL=INFO

# Auth rate limits — keyed on the trusted client IP (per user, behind the CDN).
# Bump AUTH_LOGIN_RATE for legit bursts, never disable account lockout.
AUTH_LOGIN_RATE=10/minute
AUTH_REGISTER_RATE=5/hour
AUTH_PASSWORD_RESET_RATE=5/hour

# Client-IP trust (see backend/config/client_ip.py). Defaults are Cloudflare's
# published edge ranges + the private Docker network; override only if the CDN
# or reverse-proxy topology changes.
SITE_CLOUDFLARE_IP_RANGES=
SITE_CADDY_CLIENT_IPS=
SITE_CLOUD_ADMIN=True

# PostgreSQL — use a unique random password before the first startup.
POSTGRES_DB=revayato
POSTGRES_USER=revayato
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# Watch Party
WATCH_PARTY_MAX_MEMBERS=20
WATCH_PARTY_DEFAULT_EXPIRY_MINUTES=240
WATCH_PARTY_CHAT_MAX_LENGTH=1000
CHANNEL_CAPACITY=1000
CHANNEL_EXPIRY_SECONDS=10

# TMDB credentials stay server-side only. Prefer Bearer read-access token.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_LANGUAGE=fa-IR
TMDB_FALLBACK_LANGUAGE=en-US
TMDB_REGION=IR
TMDB_TIMEOUT_SECONDS=20
TMDB_MAX_RETRIES=3
# Optional dedicated outbound proxy. Standard HTTPS/HTTP proxy variables are fallbacks.
TMDB_PROXY_URL=
OMDB_API_KEY=
OMDB_BASE_URL=https://www.omdbapi.com/
OMDB_TIMEOUT_SECONDS=12
OMDB_MAX_RETRIES=2
TVDB_API_KEY=
TRAKT_CLIENT_ID=
MEDIA_RATING_CACHE_TTL=21600
HTTPS_PROXY=
HTTP_PROXY=

# Automated catalog ingestion. Keep auto-publish off until licensed media
# keys and rights verification are supplied by your media workflow.
CATALOG_MEDIA_MANIFEST=/run/catalog-media-manifest.json
CATALOG_MEDIA_MANIFEST_HOST_PATH=./backend/catalog-media-manifest.example.json
CATALOG_SYNC_LOOKBACK_DAYS=14
CATALOG_SYNC_LOOKAHEAD_DAYS=7
CATALOG_SYNC_MAX_PAGES=2
CATALOG_SYNC_ENABLED=False
CATALOG_CACHE_INVALIDATION_MIN_INTERVAL=300
CATALOG_WORKER_CONCURRENCY=1
CATALOG_WORKER_CPUS=0.35
CATALOG_URGENT_WORKER_CONCURRENCY=1
CATALOG_URGENT_WORKER_CPUS=0.35
CATALOG_SYNC_INTERVAL_HOURS=6
CATALOG_SYNC_STAGE_BATCH_SIZE=2000
CATALOG_SYNC_PROCESS_BATCH_SIZE=20
CATALOG_SYNC_ITEM_MAX_ATTEMPTS=3
CATALOG_SYNC_ITEMS_PER_SECOND=6
CATALOG_TMDB_REFRESH_AFTER_DAYS=150
CATALOG_SYNC_STALE_REFRESH_LIMIT=50000
CATALOG_SYNC_STALE_HEARTBEAT_MINUTES=15
CATALOG_PUBLISH_INTERVAL_SECONDS=300
CATALOG_AUTO_PUBLISH=False
CELERY_BROKER_URL=redis://redis-queue:6379/0
CELERY_RESULT_BACKEND=redis://redis-queue:6379/1

# Transactional email — password reset will not work publicly until SMTP is configured.
DEFAULT_FROM_EMAIL=روایتو <no-reply@revayato.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Optional S3-compatible media storage (recommended for R2/Bunny/S3).
# Leave AWS_STORAGE_BUCKET_NAME empty to use the server's persistent media volume.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=virtual
AWS_QUERYSTRING_AUTH=False

# Private original movie archive (ArvanCloud / S3-compatible). Backend-only secrets.
# Separate from AWS_* public media storage. Keep the bucket private.
# Bucket CORS must allow the admin origin and ExposeHeaders: ETag for multipart.
# Multipart/CORS/addressing must be smoke-tested against the real Arvan endpoint.
# Archive Object Storage is not a sole backup of irreplaceable masters.
ARCHIVE_S3_ENDPOINT_URL=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
ARCHIVE_S3_BUCKET_NAME=
ARCHIVE_S3_REGION=
ARCHIVE_S3_SIGNATURE_VERSION=s3v4
ARCHIVE_S3_ADDRESSING_STYLE=path
ARCHIVE_S3_PRIVATE=True
ARCHIVE_PRESIGNED_URL_EXPIRES=900
ARCHIVE_DOWNLOAD_URL_EXPIRES=600
ARCHIVE_MULTIPART_CHUNK_SIZE_MB=64
ARCHIVE_MULTIPART_URL_BATCH_SIZE=20
ARCHIVE_UPLOAD_CONCURRENCY=3
ARCHIVE_MAX_UPLOAD_SIZE_GB=100
ARCHIVE_ALLOWED_EXTENSIONS=mkv,mp4
ARCHIVE_VERIFY_WITH_FFPROBE=False

# Licensed provider import (Avasarami). Backend-only — never NUXT_PUBLIC_*.
# Prefer official API token, authorized long-lived cookie/session, or feed.
# Do not automate CAPTCHA login.
AVASARAMI_BASE_URL=https://avasarami.top
AVASARAMI_LOGIN_URL=https://avasarami.top/sign-in/
AVASARAMI_MOVIES_URL=https://avasarami.top/movies/
AVASARAMI_SERIES_URL=https://avasarami.top/series/
AVASARAMI_AUTH_TYPE=
AVASARAMI_USERNAME=
AVASARAMI_PASSWORD=
AVASARAMI_API_TOKEN=
AVASARAMI_COOKIE=
AVASARAMI_TIMEOUT_SECONDS=30
AVASARAMI_RATE_LIMIT_PER_MINUTE=30
AVASARAMI_VERIFY_SSL=True

# Film2Media / myf2m — default public download crawler (backend/Celery only). Never NUXT_PUBLIC_*.
CATALOG_LINK_PROVIDER=myf2m
CATALOG_LINK_PROVIDERS=myf2m,dornatv
MYF2M_BASE_URL=https://www.myf2m.info
MYF2M_TIMEOUT_SECONDS=30
MYF2M_RATE_LIMIT_PER_MINUTE=30
MYF2M_VERIFY_SSL=True
MYF2M_USER_AGENT=RevayatoCatalogCrawler/1.0 (+https://revayato.ir)
MYF2M_MAX_RESULTS_PER_LOOKUP=20
MYF2M_AUTO_CRAWL_ON_PUBLISH=True
# The permanent delta crawler stays deliberately slow and CPU-capped so public
# API/frontend latency remains stable. It sleeps six hours between full sweeps.
MYF2M_BULK_CRAWL_DELAY_SECONDS=3.0
MYF2M_BULK_CRAWLER_CPUS=0.15
MYF2M_CRAWL_INTERVAL_SECONDS=21600
MYF2M_CRAWL_WORKERS=6
MYF2M_LISTING_DELAY=0.08
MYF2M_RECENT_MOVIE_PAGES=16
MYF2M_RECENT_SERIES_PAGES=10
MYF2M_DEEP_SWEEP_EVERY_ROUNDS=1
MYF2M_CRAWLER_NICE=10
MYF2M_SIZE_WORKERS=4
MYF2M_SIZE_TIMEOUT_SECONDS=10

# Dornatv — WP BartarTheme catalog + public CDN download boxes.
DORNATV_BASE_URL=https://dornatv.com
DORNATV_TIMEOUT_SECONDS=30
DORNATV_RATE_LIMIT_PER_MINUTE=30
DORNATV_VERIFY_SSL=True
DORNATV_USER_AGENT=RevayatoCatalogCrawler/1.0 (+https://revayato.ir)
DORNATV_MAX_RESULTS_PER_LOOKUP=20
DORNATV_REST_PER_PAGE=100

# Persian movie subtitle fallback. The crawler requires exact IMDb identity,
# throttles requests, and pauses automatically on Cloudflare/HTTP 429.
SUBTITLESTAR_ENABLED=True
SUBTITLESTAR_BASE_URL=https://subtitlestar.com
SUBTITLESTAR_TIMEOUT_SECONDS=20
SUBTITLESTAR_REQUEST_INTERVAL_SECONDS=4
SUBTITLESTAR_NEGATIVE_CACHE_SECONDS=86400
SUBTITLESTAR_BLOCKED_COOLDOWN_SECONDS=21600
SUBTITLESTAR_MAX_RESULTS_PER_LOOKUP=3
SUBTITLESTAR_MAX_ARCHIVE_BYTES=16777216
SUBTITLESTAR_ALLOWED_DOWNLOAD_HOSTS=subtitlestar.com,file-share.io
SUBTITLESTAR_USER_AGENT=Mozilla/5.0 (compatible; RevayatoSubtitleIndexer/1.1; +https://revayato.com)
# Optional authorized session cookie; never commit a real value.
SUBTITLESTAR_COOKIE=
CATALOG_EXCLUDE_IRANIAN=True
CATALOG_DELETE_WHEN_PROVIDER_MISSING=True

DORNATV_IMPORT_ENABLED=True
DORNATV_IMPORT_MOVIES_PER_TICK=12
DORNATV_IMPORT_SERIES_PER_TICK=6
DORNATV_IMPORT_ENABLED=True
DORNATV_IMPORT_CHECKPOINT=/tmp/dornatv_import_checkpoint.json
