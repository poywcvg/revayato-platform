# Public origins — changing these values changes generated URLs without a
# database migration. Keep object keys/paths in catalog rows only.
SITE_BASE_URL=https://revaryato.com
API_BASE_URL=https://api.revaryato.com
MEDIA_CDN_BASE_URL=https://cdn.revaryato.com
DOWNLOAD_CDN_BASE_URL=https://dl.revaryato.com
WS_BASE_URL=wss://api.revaryato.com

# Reverse-proxy hostnames (used by Caddy TLS).
SITE_DOMAIN=revaryato.com
API_DOMAIN=api.revaryato.com
MEDIA_DOMAIN=cdn.revaryato.com
DOWNLOAD_DOMAIN=dl.revaryato.com
ACME_EMAIL=admin@revaryato.com

# Django — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=revaryato.com,api.revaryato.com
DJANGO_CORS_ALLOWED_ORIGINS=https://revaryato.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://revaryato.com
DJANGO_SECURE_SSL_REDIRECT=True
# Start low for the first deployment; raise to 31536000 after HTTPS is verified.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_LOG_LEVEL=INFO
FRONTEND_URL=https://revaryato.com

# PostgreSQL — use a unique random password before the first startup.
POSTGRES_DB=revayato
POSTGRES_USER=revayato
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# Watch Party
WATCH_PARTY_MAX_MEMBERS=20
WATCH_PARTY_DEFAULT_EXPIRY_MINUTES=240
WATCH_PARTY_CHAT_MAX_LENGTH=1000
CHANNEL_CAPACITY=1000
CHANNEL_EXPIRY_SECONDS=10

# Automated catalog ingestion. Keep auto-publish off until licensed media
# keys and rights verification are supplied by your media workflow.
TMDB_API_TOKEN=
TMDB_API_KEY=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=fa-IR
TMDB_REGION=
CATALOG_MEDIA_MANIFEST=/run/catalog-media-manifest.json
CATALOG_MEDIA_MANIFEST_HOST_PATH=./backend/catalog-media-manifest.example.json
CATALOG_SYNC_LOOKBACK_DAYS=14
CATALOG_SYNC_LOOKAHEAD_DAYS=7
CATALOG_SYNC_MAX_PAGES=2
CATALOG_SYNC_ENABLED=False
CATALOG_SYNC_INTERVAL_HOURS=6
CATALOG_PUBLISH_INTERVAL_SECONDS=300
CATALOG_AUTO_PUBLISH=False
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# Transactional email — password reset will not work publicly until configured.
DEFAULT_FROM_EMAIL=روایتو <no-reply@revaryato.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Optional S3-compatible media storage (recommended for R2/Bunny/S3).
# Leave AWS_STORAGE_BUCKET_NAME empty to use the server's persistent media volume.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=virtual
AWS_QUERYSTRING_AUTH=False
