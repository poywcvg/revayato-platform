CATALOG_CACHE_LIST_TTL=60
CATALOG_CACHE_DETAIL_TTL=60
CATALOG_CACHE_HOME_TTL=60
CATALOG_CACHE_TRENDING_TTL=45
CATALOG_CACHE_GENRES_TTL=120
CATALOG_CACHE_ACTORS_TTL=120
CATALOG_CACHE_SEARCH_TTL=30

