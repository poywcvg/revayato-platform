ARCHIVE_MULTIPART_URL_BATCH_SIZE=20
ARCHIVE_UPLOAD_CONCURRENCY=3
ARCHIVE_MAX_UPLOAD_SIZE_GB=100
ARCHIVE_ALLOWED_EXTENSIONS=mkv,mp4
ARCHIVE_VERIFY_WITH_FFPROBE=False

