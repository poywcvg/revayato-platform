AVASARAMI_RATE_LIMIT_PER_MINUTE=30
AVASARAMI_VERIFY_SSL=True

# Film2Media / myf2m — default public download crawler (backend/Celery only). Never NUXT_PUBLIC_*.
CATALOG_LINK_PROVIDER=myf2m
CATALOG_LINK_PROVIDERS=myf2m,dornatv,kargadan
MYF2M_BASE_URL=https://www.myf2ms.top
MYF2M_TIMEOUT_SECONDS=30
MYF2M_RATE_LIMIT_PER_MINUTE=60
MYF2M_VERIFY_SSL=True
MYF2M_USER_AGENT=RevayatoCatalogCrawler/1.0 (+https://revayato.ir)
MYF2M_MAX_RESULTS_PER_LOOKUP=20
MYF2M_AUTO_CRAWL_ON_PUBLISH=True
MYF2M_PAGE_CACHE_TTL_SECONDS=300
MYF2M_BULK_CRAWL_DELAY_SECONDS=1.2
MYF2M_BULK_CRAWLER_CPUS=0.15
MYF2M_CRAWL_INTERVAL_SECONDS=21600
MYF2M_CRAWLER_NICE=10

# Archive completion + rating accuracy. These are lanes of the same permanent
# catalog-crawler container, not Celery beat jobs: the only queue that fits them
# (imports) runs at concurrency 1 and grows hundreds of messages deep, so a tick
# scheduled there expires before it is ever picked up.
#   drafts  — unpublished titles with NO download link at all get their providers
#             re-crawled; a bounded budget per round, sharing the provider rate
#             limit with the import lanes above.
#   imdb    — IMDb republishes its ratings dataset daily, so this is a standing
#             job. It only writes rows whose number actually moved.
#   publish — bounded because each candidate costs a live media probe; it does
#             nothing at all unless CATALOG_AUTO_PUBLISH is True.
CATALOG_DRAFT_SOURCE_ENABLED=1
CATALOG_DRAFT_SCAN_LIMIT=600
CATALOG_DRAFT_FIX_LIMIT=40
CATALOG_DRAFT_DEEP_SCAN_LIMIT=4000
CATALOG_DRAFT_DEEP_FIX_LIMIT=80
CATALOG_DRAFT_RETRY_HOURS=168
CATALOG_DRAFT_DELAY_SECONDS=1.4
CATALOG_IMDB_SYNC_ENABLED=1
CATALOG_IMDB_SYNC_EVERY_ROUNDS=6
CATALOG_PUBLISH_BATCH=200

# Bounded refresh of missing/expired catalog playback links. Automatic deletion
# stays off; use the explicit audit command for a reviewed destructive pass.
PLAYBACK_REFRESH_BATCH_SIZE=120
PLAYBACK_REFRESH_INTERVAL_SECONDS=1800
PLAYBACK_REFRESH_DELETE=False
PLAYBACK_REFRESH_DELAY_SECONDS=0.3
MYF2M_SIZE_WORKERS=4
MYF2M_SIZE_TIMEOUT_SECONDS=10

# Permanent subtitle backfill crawler (subtitle-crawler service). Revolves the
# catalog forever, enqueueing every published movie/episode missing a WebVTT
# track to the softsub worker. Queue-only, so it stays light; the heavy
# ffmpeg/download work runs on catalog-worker-softsub.
SUBTITLE_CRAWL_INTERVAL_SECONDS=900
SUBTITLE_CRAWLER_NICE=10
SUBTITLE_CRAWLER_CPUS=0.5
SUBTITLE_EXTRACT_TIMEOUT_SECONDS=240
SUBTITLE_EPISODE_LIMIT=24
# Fast lane: most-watched / newest missing titles first, every round.
SUBTITLE_FAST_MOVIE_LIMIT=40
SUBTITLE_FAST_SERIES_LIMIT=20
# Deep lane: random rotation over the whole back catalogue, every N rounds.
SUBTITLE_DEEP_EVERY_ROUNDS=4
SUBTITLE_DEEP_MOVIE_LIMIT=120
SUBTITLE_DEEP_SERIES_LIMIT=60
SUBTITLE_DRAIN_GAPS=1

# Dornatv — WP BartarTheme catalog + public CDN download boxes.
DORNATV_BASE_URL=https://dornatv.com
DORNATV_TIMEOUT_SECONDS=30
DORNATV_RATE_LIMIT_PER_MINUTE=60
DORNATV_VERIFY_SSL=True
DORNATV_USER_AGENT=RevayatoCatalogCrawler/1.0 (+https://revayato.ir)
DORNATV_MAX_RESULTS_PER_LOOKUP=20
DORNATV_REST_PER_PAGE=100

# Kargadan Movie (kargadanmovie.com). Links need a signed-in session; the site's
# sign-in has a CAPTCHA, so the crawler never logs in itself. Sign in with a
# browser, copy the request's Cookie header (DevTools → Network → any page →
# Request Headers → cookie) into KARGADAN_SESSION_COOKIE, and put that browser's
# User-Agent in KARGADAN_USER_AGENT. Never put the account password here.
KARGADAN_BASE_URL=https://kargadanmovie.com
KARGADAN_SESSION_COOKIE=
KARGADAN_USER_AGENT=RevayatoCatalogCrawler/1.0 (+https://revayato.ir)
KARGADAN_RATE_LIMIT_PER_MINUTE=20
KARGADAN_IMPORT_ENABLED=True
KARGADAN_IMPORT_MOVIES_PER_TICK=8
KARGADAN_IMPORT_SERIES_PER_TICK=4
KARGADAN_IMPORT_REFRESH_PER_TICK=12

# Persian movie subtitles (IMDb-strict fallback for online playback).
SUBTITLESTAR_ENABLED=True
SUBTITLESTAR_BASE_URL=https://subtitlestar.com
SUBTITLESTAR_TIMEOUT_SECONDS=20
SUBTITLESTAR_REQUEST_INTERVAL_SECONDS=4
SUBTITLESTAR_NEGATIVE_CACHE_SECONDS=86400
SUBTITLESTAR_BLOCKED_COOLDOWN_SECONDS=21600
SUBTITLESTAR_MAX_RESULTS_PER_LOOKUP=3
SUBTITLESTAR_MAX_ARCHIVE_BYTES=16777216
SUBTITLESTAR_ALLOWED_DOWNLOAD_HOSTS=subtitlestar.com,file-share.io
SUBTITLESTAR_USER_AGENT=Mozilla/5.0 (compatible; RevayatoSubtitleIndexer/1.1; +https://revayato.com)
# SubDL (subdl.com) official subtitle API: free key from a subdl.com account.
# Empty = provider off. Exact IMDb-id lookups; tried after SubtitleStar.
SUBDL_API_KEY=
SUBDL_ENABLED=True
SUBTITLESTAR_COOKIE=
CATALOG_EXCLUDE_IRANIAN=True
CATALOG_DELETE_WHEN_PROVIDER_MISSING=True


NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_WS_BASE=
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_MEDIA_CDN_BASE_URL=
NUXT_PUBLIC_DOWNLOAD_CDN_BASE_URL=

DORNATV_IMPORT_ENABLED=True
DORNATV_IMPORT_MOVIES_PER_TICK=12
DORNATV_IMPORT_SERIES_PER_TICK=6
# Must live on the persistent /app/media volume. /tmp in the catalog workers is a
# tmpfs that is wiped on every container restart, so a checkpoint there rewinds the
# whole discovery walk on each deploy.
DORNATV_IMPORT_CHECKPOINT=/app/media/dornatv_import_checkpoint.json
# Release-year window walked newest → oldest. Leave YEAR_START at 0 to follow the
# clock (next calendar year) instead of pinning the crawl to a year.
DORNATV_IMPORT_YEAR_START=0
DORNATV_IMPORT_YEAR_END=1970

# Film2Media discovery — listing-driven twin of the Dornatv walk, so titles only
# Film2Media publishes still reach the catalog.
MYF2M_IMPORT_ENABLED=True
MYF2M_IMPORT_MOVIES_PER_TICK=8
MYF2M_IMPORT_SERIES_PER_TICK=4
MYF2M_IMPORT_MAX_PAGES_PER_TICK=12
MYF2M_IMPORT_CHECKPOINT=/app/media/myf2m_import_checkpoint.json
MYF2M_IMPORT_YEAR_START=0
MYF2M_IMPORT_YEAR_END=1970

# Playback gateway — the fallback that rewraps a source into fragmented-MP4 HLS
# when a browser genuinely cannot open the file. Runs in its own container
# (stream-gateway), and every limit here is really a *disk* limit: each live
# session parks roughly eight minutes of video on the session volume.
STREAM_ALLOW_TRANSCODE=True
STREAM_MAX_CONCURRENT_REMUX=4
STREAM_MAX_CONCURRENT_TRANSCODE=1
# Past this, new sessions are refused with «busy» rather than filling the disk
# the rest of the site shares.
STREAM_DISK_BUDGET_MB=1536
STREAM_WEB_CONCURRENCY=2
STREAM_LIMIT_CONCURRENCY=120
STREAM_GATEWAY_MEM=768m
STREAM_GATEWAY_CPUS=0.9

# Three import children: one for the IMDb Top 250 lane, one for discovery, one for bulk retries (imports-top250,imports-discovery listed first in -Q).
CATALOG_IMPORTS_WORKER_CONCURRENCY=3
